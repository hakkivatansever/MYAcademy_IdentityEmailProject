                    ${s.unread
                      ? `<button type="button" class="db-chip warn" data-stat="unread"><i class="bi bi-exclamation-circle"></i> <b>${s.unread}</b> okunmamış mesaj bekliyor</button>`
                      : `<span class="db-chip ok"><i class="bi bi-check2-circle"></i> Tüm mesajlar okundu</span>`}
                  </div>
                </div>
                <div class="db-illus" aria-hidden="true">
                  <span class="plane"><i class="bi bi-send-fill"></i></span>
                  <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span>
                  <div class="env">
                    <div class="letter"><i></i><i></i><i></i></div>
                    <div class="env-front"></div>
                    ${s.unread ? `<span class="env-badge">${s.unread}</span>` : ''}
                  </div>
                </div>
              </div>

              <!-- İstatistik kartları (StatCardsViewComponent) -->
              <div class="db-stats">
                ${stat('received', 't-blue', 'bi-inbox-fill', s.received, 'Gelen Mesajlar', `Bugün ${s.todayReceived} yeni mesaj`, '<i class="bi bi-arrow-up-right"></i> %12')}
                ${stat('sent', 't-lav', 'bi-send-fill', s.sent, 'Gönderilen Mesajlar', `Bu hafta ${week.totalSent} mesaj`, '<i class="bi bi-arrow-up-right"></i> %8')}
                ${stat('unread', 't-mint', 'bi-envelope-fill', s.unread, 'Okunmamış Mesajlar', 'Gelen kutunuzda bekliyor', `Kutunun %${Math.round(s.unread / Math.max(s.inbox, 1) * 100)}'i`)}
                ${stat('starred', 't-peach', 'bi-star-fill', s.starred, 'Yıldızlı Mesajlar', s.starredUnread ? `${s.starredUnread} tanesi henüz okunmadı` : 'Tamamı okundu', 'Önemli')}
              </div>

              <!-- Grafikler -->
              <div class="db-row charts">
                <div class="db-card db-traffic">
                  <div class="db-card-head">
                    <div>
                      <h3>Mesaj Trafiği</h3>
