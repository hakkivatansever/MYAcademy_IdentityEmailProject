              <div class="num">${value.toLocaleString('tr-TR')}</div>
              <div class="lbl">${label}</div>
              <div class="desc"><span>${desc}</span><i class="bi bi-arrow-right"></i></div>
            </button>`;

          const tile = (page, theme, icon, title, sub) => `
