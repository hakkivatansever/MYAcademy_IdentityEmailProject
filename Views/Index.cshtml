                        <span class="avatar ${m.color}">${initials(m.name)}</span>
                        <span class="bd">
                          <span class="nm">${escapeHtml(m.name)}${m.unread ? '<span class="unread-dot" title="Okunmamış"></span>' : ''}</span>
                          <span class="sj d-block">${escapeHtml(m.subject)}</span>
                          <span class="sn d-block">${escapeHtml(m.snippet)}</span>
